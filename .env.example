# ── Project environment variables — Example file ───────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini chatbot (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Field encryption (optional)
FIELD_ENCRYPTION_KEY=

# Email (optional — console backend used in DEBUG when not set)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sentinel <noreply@sentinel.local>

# ── InsForge BaaS ──────────────────────────────────────────────────────────
# Get these from: npx @insforge/cli secrets get ANON_KEY
# and: npx @insforge/cli secrets get JWT_SECRET
INSFORGE_URL=https://your-appkey.region.insforge.app
INSFORGE_ANON_KEY=
INSFORGE_JWT_SECRET=
