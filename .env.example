# Copy to .env or export these values in your shell before starting Django.
# Never commit real credentials.

DEBUG=True
# Local DEBUG mode generates a temporary key when blank. Set a unique secret in production.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: enables Sentinel Assistant chatbot responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Required only for encrypted PII fields.
FIELD_ENCRYPTION_KEY=

# Optional SMTP settings for password reset emails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sentinel <noreply@sentinel.local>
