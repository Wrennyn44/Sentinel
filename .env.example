# ── Project environment variables — Example file ───────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini chatbot (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# InsForge Google OAuth
INSFORGE_BASE_URL=https://zqtvr338.ap-southeast.insforge.app
INSFORGE_ANON_KEY=
# Use your public HTTPS domain in production. Allowlist
# SITE_BASE_URL/auth/google/callback/ in InsForge Auth settings.
SITE_BASE_URL=http://localhost:8000

# Field encryption (optional)
FIELD_ENCRYPTION_KEY=

# Email (optional — console backend used in DEBUG when not set)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sentinel <noreply@sentinel.local>

